# Neon read-only connection string for the SIG de suelo.
# Use a dedicated SELECT-only role. Server-side ONLY — never expose with a
# NEXT_PUBLIC_ prefix. Set the real value in .env.local (gitignored) and in
# Vercel → Environment Variables.
NEON_DATABASE_URL=postgresql://web_readonly:<password>@<project>.neon.tech/<database>?sslmode=require&channel_binding=require

# Analítica interna (opcional). Sin estas variables queda apagada.
# Rol `analytics_writer` creado por db/analytics.sql: solo INSERT/SELECT/DELETE
# sobre el esquema `analytics`, sin acceso a las transacciones CBR.
ANALYTICS_DATABASE_URL=postgresql://analytics_writer:<password>@<project>.neon.tech/<database>?sslmode=require
# Secreto para el hash diario de visitantes (32+ caracteres aleatorios).
# Ej.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ANALYTICS_SALT=
