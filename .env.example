# Neon read-only connection string for the SIG de suelo.
# Use a dedicated SELECT-only role. Server-side ONLY — never expose with a
# NEXT_PUBLIC_ prefix. Set the real value in .env.local (gitignored) and in
# Vercel → Environment Variables.
NEON_DATABASE_URL=postgresql://web_readonly:<password>@<project>.neon.tech/<database>?sslmode=require&channel_binding=require
